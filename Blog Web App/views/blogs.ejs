<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Edu+AU+VIC+WA+NT+Hand:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <div class="menu">
        <a href="/">
          <button>Home</button>
        </a>
        <a href="/blogs">
          <button>Blogs</button>
        </a>
      </div>
      <div class="title">
        <h1>My Blogs</h1>
      </div>
      <div class="content" style="overflow-y: visible">
        <% if(locals.blogs) { %>
        <ul>
          <% blogs.forEach((blog, index) => { %>
          <li>
            <a href="/blogs/<%= index %>"><%= blog.title %></a>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>

    <a href="#" id="addButton" class="round-button-add">+</a>

    <form action="/blogs" method="post" class="hidden" id="formBox">
      <button href="#" id="okeyButton" class="round-button-okey">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="25"
          height="25"
          fill="currentColor"
          class="bi bi-check"
          viewBox="0 0 16 16"
        >
          <path
            d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"
          />
        </svg>
      </button>

      <div class="form">
        <h2>Blog Title</h2>
        <textarea name="title" id="title"></textarea>
        <h2>Blog Content</h2>
        <textarea name="text" id="text"></textarea>
      </div>
    </form>

    <script src="/scripts/script.js"></script>
  </body>
</html>
